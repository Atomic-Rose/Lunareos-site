---
import { SITE, NAV_LINKS, withBase } from '../site'

/* Trailing slash normalised so /studio and /studio/ both mark themselves. */
const here = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="site-header">
  <div class="site-header__inner">
    {/*
      Wordmark-only on wider screens; symbol-only below the point where the
      wordmark would fall under its minimum legible size.
    */}
    <a class="site-header__brand" href={withBase('/')} aria-label="Lunareos — home">
      <img
        class="site-header__lockup"
        src={withBase('/lunareos-wordmark-silver.svg')}
        alt="Lunareos"
        width="1174"
        height="174"
      />
      <img
        class="site-header__symbol"
        src={withBase('/lunareos-symbol-silver.svg')}
        alt="Lunareos"
        width="185"
        height="185"
      />
    </a>

    {/*
      The nav is back because there is somewhere to go: the home page is the
      system, and the work is its own page. It carries real pages only — never
      anchors to sections of the page you are already looking at.
    */}
    <div class="site-header__actions">
      <nav aria-label="Primary">
        <ul class="site-header__nav">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  class="site-header__link"
                  href={link.href}
                  aria-current={here === link.href.replace(/\/$/, '') ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a class="button" href={`mailto:${SITE.email}`}>Email</a>
    </div>
  </div>
</header>
