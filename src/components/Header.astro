---
import { NAV, SITE } from '../site'
---

<header class="site-header">
  <div class="site-header__inner">
    {/*
      Two lockups, swapped by CSS at the width where the horizontal logo would
      fall below the brand kit's 140px artwork minimum. Below that the kit's
      guidance is symbol-only (24px minimum), not a shrunken lockup.
    */}
    <a class="site-header__brand" href="/" aria-label="Lunareos — home">
      <img
        class="site-header__lockup"
        src="/lunareos-logo-horizontal-silver.svg"
        alt="Lunareos"
        width="1614"
        height="399"
      />
      <img
        class="site-header__symbol"
        src="/lunareos-symbol-silver.svg"
        alt="Lunareos"
        width="185"
        height="185"
      />
    </a>

    <nav class="site-nav" aria-label="Primary">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="button" href={`mailto:${SITE.email}`}>Email</a>
    </nav>
  </div>
</header>
