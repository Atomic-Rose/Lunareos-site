---
import { SITE, withBase } from '../site'
---

<header class="site-header">
  <div class="site-header__inner">
    {/*
      Two lockups, swapped by CSS at the width where the horizontal logo would
      fall below the brand kit's 140px artwork minimum. Below that the kit's
      guidance is symbol-only (24px minimum), not a shrunken lockup.
    */}
    <a class="site-header__brand" href={withBase('/')} aria-label="Lunareos — home">
      <img
        class="site-header__lockup"
        src={withBase('/lunareos-logo-horizontal-silver.svg')}
        alt="Lunareos"
        width="1614"
        height="399"
      />
      <img
        class="site-header__symbol"
        src={withBase('/lunareos-symbol-silver.svg')}
        alt="Lunareos"
        width="185"
        height="185"
      />
    </a>

    {/*
      One action, not a nav. With a two-section page there is nothing to
      navigate to, so the header offers the only thing worth doing.
    */}
    <a class="button" href={`mailto:${SITE.email}`}>Email</a>
  </div>
</header>
