---
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { SITE } from '../site'

import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/layout.css'
import '../styles/components.css'

interface Props {
  /** Page title, rendered as `<title> — Lunareos`. Omit on the home page. */
  title?: string
  description?: string
  /** Overrides the `og:title`, which otherwise mirrors the page title. */
  ogTitle?: string
}

const { title, description = SITE.description, ogTitle } = Astro.props

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — Software that stays yours`
const canonical = new URL(Astro.url.pathname, SITE.url).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#0a0d16" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={ogTitle ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <!-- PNG, not SVG: no major platform renders SVG in a link preview. -->
    <meta property="og:image" content={new URL('/og-image.png', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lunareos — Software that stays yours." />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts are linked (not @import-ed) so the browser can start fetching
         them in parallel with the stylesheet rather than after it. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500&family=JetBrains+Mono:wght@400&display=swap"
    />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <Header />
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
