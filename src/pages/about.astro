---
import Base from '../layouts/Base.astro'
import { SITE } from '../site'

/*
 * Copy on this page is approved verbatim. The only editorial change is
 * paragraph breaks for readability — no wording has been altered, and the
 * closing sentence is pulled out as the standalone statement.
 */
---

<Base
  title="Studio"
  description="Lunareos is an independent software studio that builds across entirely different genres, because interesting problems exist everywhere."
  ogTitle="The Lunareos studio"
>
  <!-- ===== Page hero ===================================================== -->
  <section class="page-hero" aria-labelledby="page-title">
    <div class="glow page-hero__glow" aria-hidden="true"></div>
    <div class="shell page-hero__inner">
      <p class="label label--accent">The studio</p>
      <h1 class="page-hero__title" id="page-title">
        Lunareos does not fit into a single box.
      </h1>
      <p class="lede page-hero__lede">
        We are an independent software studio that builds across entirely
        different genres—because interesting problems exist everywhere.
      </p>
    </div>
  </section>

  <!-- ===== Philosophy =====================================================
       The approved sentence is set as the heading itself rather than being
       summarised into one, so nothing is carved up or repeated. -->
  <section class="section section--hairline" aria-labelledby="philosophy-title">
    <div class="shell">
      <div class="section-head section-head--statement">
        <p class="label label--accent">Philosophy</p>
        <h2 id="philosophy-title">
          The studio operates on a simple philosophy: build what is useful,
          build what is needed, and engineer it properly for its specific
          context.
        </h2>
        <p>
          Sometimes that means prioritizing strict local data architecture for a
          writing application, and other times it means focusing on high-level
          data aggregation for a security platform.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Contact ======================================================== -->
  <section class="section contact section--hairline" aria-labelledby="about-contact-title">
    <div class="glow contact__glow" aria-hidden="true"></div>
    <div class="shell contact__inner">
      <p class="label label--accent">Contact</p>
      <h2 class="contact__title" id="about-contact-title">Get in touch.</h2>
      <a class="contact__address" href={`mailto:${SITE.email}`}>
        {SITE.email} <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>
