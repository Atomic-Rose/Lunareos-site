---
import Base from '../layouts/Base.astro'
import SystemView from '../components/SystemView.astro'

/*
 * The home page is the system and nothing else: one screen, no scroll, every
 * project reachable from orbit. The work it points at lives at /studio/.
 *
 * `chrome="system"` swaps the full footer for the one-line bar the fixed
 * screen can carry. See the README.
 */
---

<Base ogTitle="Lunareos — Independent software studio" chrome="system">
  <SystemView />
</Base>
