---
import Base from '../layouts/Base.astro'
import { SITE } from '../site'

/*
 * Copy on this page is approved verbatim. Don't rewrite it, and don't add
 * new prose around it — the home page is deliberately short. The philosophy
 * lives on /about/.
 */

const facts = [
  { field: 'Studio', value: 'Lunareos LLC — independent' },
  { field: 'Scope', value: 'Creative environments to enterprise systems' },
]
---

<Base
  ogTitle="Lunareos — Specialized tools for interesting problems"
  description="Lunareos builds specialized tools to solve interesting problems, regardless of the industry."
>
  <!-- ===== Hero ========================================================== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="glow hero__glow" aria-hidden="true"></div>

    <div class="shell hero__inner">
      <p class="label hero__eyebrow">Software · Design · Imagination</p>

      <div class="hero__copy">
        <h1 class="hero__title" id="hero-title">
          Lunareos builds specialized tools to solve interesting problems,
          regardless of the industry.
        </h1>

        <p class="lede hero__lede">
          From creative environments to enterprise systems, Lunareos is an
          independent studio crafting software that works.
        </p>

        <div class="hero__actions">
          <a class="button" href={`mailto:${SITE.email}`}>
            Say hello <span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a class="link" href="/about/">
            About the studio <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      {/* The brand symbol, unmodified, sitting in front of the glow layer —
          the kit forbids compositing a glow onto the artwork itself. */}
      <div class="hero__mark" aria-hidden="true">
        <img src="/lunareos-symbol-silver.svg" alt="" width="185" height="185" />
      </div>
    </div>
  </section>

  <!-- ===== Facts strip =================================================== -->
  <div class="shell">
    <dl class="statusbar">
      {
        facts.map((item) => (
          <div class="statusbar__cell">
            <dt class="label">{item.field}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
      <div class="statusbar__cell">
        <dt class="label">Contact</dt>
        <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
      </div>
    </dl>
  </div>

  <!-- ===== Contact ======================================================= -->
  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="glow contact__glow" aria-hidden="true"></div>
    <div class="shell contact__inner">
      <p class="label label--accent">Contact</p>
      <h2 class="contact__title" id="contact-title">Get in touch.</h2>
      <a class="contact__address" href={`mailto:${SITE.email}`}>
        {SITE.email} <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>
