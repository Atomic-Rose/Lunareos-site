---
import Base from '../layouts/Base.astro'
import { SITE } from '../site'

/*
 * Copy on this page is approved verbatim. Don't rewrite it.
 * The studio section lives here rather than on its own page — the nav and
 * footer point at #studio.
 */
---

<Base ogTitle="Lunareos — Independent software studio">
  <!-- ===== Hero ========================================================== -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="glow hero__glow" aria-hidden="true"></div>

    <div class="shell hero__inner">
      <p class="label hero__eyebrow">Software · Design · Imagination</p>

      <div class="hero__copy">
        <h1 class="hero__title" id="hero-title">Lunareos builds its own software.</h1>
        <p class="lede hero__lede">
          An independent studio building specialized tools, engineered properly
          for the work they support.
        </p>
      </div>

      {/* The brand symbol, unmodified, sitting in front of the glow layer —
          the kit forbids compositing a glow onto the artwork itself. */}
      <div class="hero__mark" aria-hidden="true">
        <img src="/lunareos-symbol-silver.svg" alt="" width="185" height="185" />
      </div>
    </div>
  </section>

  <!-- ===== Studio ======================================================== -->
  <section class="section section--hairline" id="studio" aria-labelledby="studio-title">
    <div class="shell editorial">
      <div>
        <p class="label label--accent">Studio</p>
        <h2 class="editorial__title" id="studio-title">
          Useful, needed, and properly engineered.
        </h2>
      </div>
      <div>
        <p class="lede">
          Build what is useful, build what is needed, and engineer it properly
          for its context.
        </p>
        <p class="prose">
          That is why Lunareos does not stay inside one field. The context sets
          the standard, and the standard does not move.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== Contact ======================================================= -->
  <section class="section section--hairline contact" id="contact" aria-labelledby="contact-title">
    <div class="glow contact__glow" aria-hidden="true"></div>
    <div class="shell contact__inner">
      <p class="label label--accent">Contact</p>
      <h2 class="contact__title" id="contact-title">Get in touch.</h2>
      <p class="contact__body">
        For questions about a project, or a problem that belongs in one.
      </p>
      <a class="contact__address" href={`mailto:${SITE.email}`}>
        {SITE.email} <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>
