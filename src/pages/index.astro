---
import Base from '../layouts/Base.astro'
import { SITE, withBase } from '../site'

/*
 * Copy on this page is approved. Don't rewrite it.
 * Two sections only: hero, then contact. See the README for the rules the
 * copy was written to.
 */
---

<Base ogTitle="Lunareos — Independent software studio">
  <!-- ===== Hero ========================================================== -->
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="glow hero__glow" aria-hidden="true"></div>

    <div class="shell hero__inner">
      <p class="label hero__eyebrow">Software · Design · Imagination</p>

      <div class="hero__copy">
        <h1 class="hero__title" id="hero-title">Software for whatever comes next.</h1>
        <p class="lede hero__lede">
          Lunareos is an independent studio exploring ideas, problems, and
          possibilities through software.
        </p>
      </div>

      {/* The brand symbol, unmodified, sitting in front of the glow layer —
          the kit forbids compositing a glow onto the artwork itself. */}
      <div class="hero__mark" aria-hidden="true">
        <img src={withBase('/lunareos-symbol-silver.svg')} alt="" width="185" height="185" />
      </div>
    </div>
  </section>

  <!-- ===== Contact ======================================================= -->
  <section class="section section--hairline contact" id="contact" aria-labelledby="contact-title">
    <div class="glow contact__glow" aria-hidden="true"></div>
    <div class="shell contact__inner">
      <p class="label label--accent">Contact</p>
      <h2 class="contact__title" id="contact-title">Get in touch.</h2>
      <p class="contact__body">
        It's a small studio, so this goes straight to us.
      </p>
      <a class="contact__address" href={`mailto:${SITE.email}`}>
        {SITE.email} <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>
