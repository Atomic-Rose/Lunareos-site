---
import Base from '../layouts/Base.astro'
import { SITE, FEATURED, STUDIO_PROJECTS, withBase } from '../site'

/*
 * The work. Copy on this page is approved — it is the same copy that used to
 * sit under the home page's hero, moved rather than rewritten when the home
 * page became the system and nothing else.
 *
 * Both project sections are driven by FEATURED and STUDIO_PROJECTS in site.ts.
 * Add a project there and it appears here and in orbit on the home page.
 */
---

<Base
  title="Studio"
  description="What Lunareos is building: MUSE, a writing environment for long-form work, and the projects in progress around it."
>
  <section class="page-hero" aria-labelledby="page-title">
    <div class="glow page-hero__glow" aria-hidden="true"></div>
    <div class="shell page-hero__inner">
      <p class="label label--accent">Lunareos</p>
      <h1 class="page-hero__title" id="page-title">Studio</h1>
      <p class="lede page-hero__lede">
        Products from Lunareos, starting with MUSE and the systems growing around it.
      </p>
    </div>
  </section>

  <!-- ===== Currently: the featured project =============================== -->
  <section
    class="section section--hairline featured"
    id="currently"
    aria-labelledby="currently-title"
  >
    <div class="glow featured__glow" aria-hidden="true"></div>

    <div class="shell featured__inner">
      {/* The rule and the status sit on the section's own line, the way the
          hero eyebrow does — status as metadata, not as a badge on a card. */}
      <div class="section__head">
        <h2 class="label" id="currently-title">Currently</h2>
        <span class="rule" aria-hidden="true"></span>
        <p class="label status">{FEATURED.status}</p>
      </div>

      {/* Name, summary, platforms, handoff — in that order, in one column.
          The link used to sit baseline-right of the name, a full shell width
          away from the sentence it follows from; it belongs at the end of the
          copy it is the next step after. */}
      <div class="feature__head">
        <div>
          <h3 class="feature__title">{FEATURED.name}</h3>
          <p class="lede feature__lede">{FEATURED.summary}</p>

          <p class="label feature__platforms">
            {FEATURED.platforms.join(' · ')}
          </p>

          {/* MUSE has its own site; this is the handoff to it. */}
          <a class="feature__link" href={FEATURED.href}>
            {FEATURED.link} <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <dl class="facts feature__facts">
          {
            FEATURED.details.map((detail) => (
              <div class="fact">
                <dt>{detail.label}</dt>
                <dd>{detail.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {/* Three bands. Without a real middle capture the wide asset covers
          861–1150px and the frame crops the binder off it in CSS — hence the
          --crop modifier, which exists only while imageMid is missing. Drop
          the capture in and the modifier, the CSS crop, and the wider portrait
          band all switch off together. See the README. */}
      <figure class:list={['feature__visual', !FEATURED.imageMid && 'feature__visual--crop']}>
        <a class="feature__shot" href={FEATURED.href} tabindex="-1">
          <picture>
            <source
              media={FEATURED.imageMid ? '(max-width: 640px)' : '(max-width: 999px)'}
              srcset={withBase(FEATURED.imageNarrow)}
              width={FEATURED.imageNarrowW}
              height={FEATURED.imageNarrowH}
            />
            {
              FEATURED.imageMid && (
                <source
                  media="(max-width: 1150px)"
                  srcset={withBase(FEATURED.imageMid)}
                  width={FEATURED.imageMidW}
                  height={FEATURED.imageMidH}
                />
              )
            }
            <img
              src={withBase(FEATURED.image)}
              alt={FEATURED.imageAlt}
              width={FEATURED.imageW}
              height={FEATURED.imageH}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </a>

        <figcaption class="label feature__caption">
          {FEATURED.name} · {FEATURED.caption}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ===== In development ================================================= -->
  <section class="section section--hairline" id="studio" aria-labelledby="studio-title">
    <div class="shell">
      <div class="section__head">
        <h2 class="label" id="studio-title">In development</h2>
        <span class="rule" aria-hidden="true"></span>
      </div>

      <div class="product-list">
        {
          STUDIO_PROJECTS.map((project) => (
            <article class="product">
              {project.href ? (
                <a class="product__main" href={project.href}>
                  <span class="label status">{project.kind}</span>
                  <h3 class="product__name">{project.name}</h3>
                  <p class="product__summary">{project.summary}</p>
                  <span class="product__link">
                    Visit site <span class="arrow" aria-hidden="true">↗</span>
                  </span>
                </a>
              ) : (
                <div class="product__main">
                  <span class="label status">{project.kind}</span>
                  <h3 class="product__name">{project.name}</h3>
                  <p class="product__summary">{project.summary}</p>
                </div>
              )}

              {project.details && (
                <dl class="facts product__facts">
                  {project.details.map((detail) => (
                    <div class="fact">
                      <dt>{detail.label}</dt>
                      <dd>{detail.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Contact ======================================================= -->
  <section class="section section--hairline contact" id="contact" aria-labelledby="contact-title">
    <div class="glow contact__glow" aria-hidden="true"></div>
    <div class="shell contact__inner">
      <p class="label label--accent">Contact</p>
      <h2 class="contact__title" id="contact-title">Get in touch.</h2>
      <p class="contact__body">
        For product questions, early access, or studio inquiries.
      </p>
      <a class="contact__address" href={`mailto:${SITE.email}`}>
        {SITE.email} <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>
